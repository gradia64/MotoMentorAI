{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "The user's display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user registered" }
      },
      "required": ["username"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "A motorcycle in the user's garage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "string" },
        "kilometers": { "type": "string" },
        "photo": { "type": "string" },
        "vin": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "displacement": { "type": "string" },
        "power": { "type": "string" },
        "frontTire": { "type": "string" },
        "rearTire": { "type": "string" },
        "insuranceExpiry": { "type": "string" },
        "taxExpiry": { "type": "string" },
        "inspectionExpiry": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "model"]
    },
    "SavedTrip": {
      "title": "SavedTrip",
      "description": "A planned trip or tour",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "data": { "type": "object", "description": "The full trip data including itinerary and diary entries" }
      },
      "required": ["id", "userId", "data"]
    },
    "Diagnosis": {
      "title": "Diagnosis",
      "description": "A mechanical diagnosis result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "data": { "type": "object", "description": "The diagnosis data" }
      },
      "required": ["id", "userId", "data"]
    },
    "MaintenanceRecord": {
      "title": "MaintenanceRecord",
      "description": "A log entry for maintenance performed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "data": { "type": "object", "description": "The maintenance record data" }
      },
      "required": ["id", "userId", "data"]
    },
    "MaintenanceReminder": {
      "title": "MaintenanceReminder",
      "description": "A reminder for future maintenance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "data": { "type": "object", "description": "The reminder data" }
      },
      "required": ["id", "userId", "data"]
    },
    "SavedChat": {
      "title": "SavedChat",
      "description": "A saved AI chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "data": { "type": "object", "description": "The chat history and metadata" }
      },
      "required": ["id", "userId", "data"]
    },
    "SharedTrip": {
      "title": "SharedTrip",
      "description": "A publicly shared trip itinerary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "tripTitle": { "type": "string" },
        "itinerary": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "tripTitle", "itinerary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/users/{userId}/vehicles/{vehicleId}": { "schema": "Vehicle", "description": "User's motorcycles" },
    "/users/{userId}/trips/{tripId}": { "schema": "SavedTrip", "description": "User's saved trips" },
    "/users/{userId}/diagnoses/{diagnosisId}": { "schema": "Diagnosis", "description": "User's saved diagnoses" },
    "/users/{userId}/maintenance/{recordId}": { "schema": "MaintenanceRecord", "description": "User's maintenance log" },
    "/users/{userId}/reminders/{reminderId}": { "schema": "MaintenanceReminder", "description": "User's reminders" },
    "/users/{userId}/chats/{chatId}": { "schema": "SavedChat", "description": "User's saved chats" },
    "/sharedTrips/{sharedTripId}": { "schema": "SharedTrip", "description": "Publicly shared trips" }
  }
}

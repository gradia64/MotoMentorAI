rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Fields:
    //   - username: string (required)
    //   - createdAt: string (optional)
    //
    // Collection: /users/{userId}/vehicles/{vehicleId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - model: string (required)
    //   - year: string (optional)
    //   - kilometers: string (optional)
    //   - photo: string (optional)
    //   - vin: string (optional)
    //   - purchaseDate: string (optional)
    //   - displacement: string (optional)
    //   - power: string (optional)
    //   - frontTire: string (optional)
    //   - rearTire: string (optional)
    //   - insuranceExpiry: string (optional)
    //   - taxExpiry: string (optional)
    //   - inspectionExpiry: string (optional)
    //   - notes: string (optional)
    //
    // Collection: /users/{userId}/trips/{tripId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - data: map (required)
    //
    // Collection: /users/{userId}/diagnoses/{diagnosisId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - data: map (required)
    //
    // Collection: /users/{userId}/maintenance/{recordId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - data: map (required)
    //
    // Collection: /users/{userId}/reminders/{reminderId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - data: map (required)
    //
    // Collection: /users/{userId}/chats/{chatId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - data: map (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username']) &&
             data.username is string && data.username.size() > 0 && data.username.size() < 100;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'userId', 'model']) &&
             data.id is string && data.userId is string && data.model is string &&
             data.model.size() < 200;
    }

    function isValidGenericData(data) {
      return data.keys().hasAll(['id', 'userId', 'data']) &&
             data.id is string && data.userId is string && data.data is map;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);

      match /vehicles/{vehicleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVehicle(request.resource.data);
        allow update: if isOwner(userId) && isValidVehicle(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /trips/{tripId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow update: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /diagnoses/{diagnosisId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow update: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /maintenance/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow update: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow update: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow update: if isOwner(userId) && isValidGenericData(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /sharedTrips/{sharedTripId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}

{
  "name": "motomentor-ai",
  "version": "1.0.0",
  "description": "MotoMentor AI - assistente personale per motociclisti: pianificazione viaggi, garage e meccanico virtuale (desktop, dati 100% locali)",
  "author": "Gaetano Sore",
  "license": "GPL-3.0",
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.json && node --test --disable-warning=ExperimentalWarning \"tests/*.test.mjs\"",
    "electron:dev": "npm run build && MMAI_DEV=1 electron .",
    "electron:run": "electron .",
    "dist": "npm run build && electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@heroicons/react": "^2.1.3",
    "bcryptjs": "^3.0.3",
    "jspdf": "^4.2.1",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.motomentor.ai",
    "productName": "MotoMentor AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "mmt.json",
        "name": "Viaggio MotoMentor",
        "description": "Viaggio condiviso MotoMentor AI",
        "mimeType": "application/x-motomentor-trip"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Gaetano Sore",
      "icon": "build/icons"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  }
}
